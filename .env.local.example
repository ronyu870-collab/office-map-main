NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
NEXT_PUBLIC_AMAP_KEY=REPLACE_ME
NEXT_PUBLIC_AMAP_SECURITY_CODE=REPLACE_ME

# Intelligence Pilot Preview：管理员始终可见；设置为 true 后向其他已登录角色开放主页入口。
NEXT_PUBLIC_INTELLIGENCE_PREVIEW=false

# 仅服务端使用；不要加 NEXT_PUBLIC_ 前缀。
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Intelligence AI：DeepSeek 官方 API。Key 仅配置在服务端/Vercel Secret 中，禁止提交真实值。
DEEPSEEK_API_KEY=sk_REPLACE_ME
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_FALLBACK_MODEL=deepseek-v4-flash

# 租赁企业匹配：off（默认）/ shadow（仅后台收样本）/ hints（按关系通过校准后才显示）。
LEASE_COMPANY_AI_MODE=off

# 云端资料库连接阿里云 OSS。
NEW_OSS_AK=
NEW_OSS_SK=
NEW_OSS_REGION=oss-cn-hongkong
NEW_OSS_BUCKET=

# Private photo preview: default on. Set 0 to serve originals when Storage Image Transformations is unavailable.
# BUILDING_PHOTO_PREVIEWS_ENABLED=0
# Set 0 to return the previous signed preview URL instead of same-origin WebP bytes.
# BUILDING_PHOTO_INLINE_PREVIEWS_ENABLED=0

# Local building media trial (optional; requires provisioned private pilot objects).
# NEXT_PUBLIC_MAP_BUILDING_MEDIA_PILOT=1

# F6 管理员核实试点；迁移和目标环境验收通过前保持 false
LEASE_EXPIRY_REVIEW_ENABLED=false

# Optional non-sensitive trial notice; set before building the preview (does not grant access).
LEASE_EXPIRY_REVIEW_TRIAL_LABEL=
